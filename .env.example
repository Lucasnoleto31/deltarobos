# Copie para .env.local e preencha. NUNCA commitar .env.local.

# Projeto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave "anon" (JWT legada, começa com eyJ...). Vai pro browser, só lê views públicas.
# Precisa ser a anon, não a "publishable": os canais privados do Realtime validam o JWT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# chave "service_role" (legada) ou "secret" (nova). SÓ no servidor (ingest). Nunca com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (OG, links absolutos). Em produção a Vercel preenche.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
